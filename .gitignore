# TrackMyRupee: one .gitignore for the whole repo (frontend + backend).
# Patterns without a leading "/" match in every folder.

# ---------- Environment files (secrets) ----------
# Ignore every .env file (.env, .env.dev, .env.prod, .env.local…)
# but keep the example templates.
.env*
!.env.example

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build output ----------
# backend (tsup)
backend/dist/
# frontend (Next.js)
frontend/.next/
frontend/out/
frontend/build/
next-env.d.ts
*.tsbuildinfo

# ---------- Testing ----------
coverage/

# ---------- Logs ----------
# backend error log files (backend/logs/error.<date>.<n>.log)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Misc ----------
.DS_Store
*.pem
.vercel
