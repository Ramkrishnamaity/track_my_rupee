# Copy to .env.dev (development) or .env.prod (production) and fill in.
NODE_ENV=
PORT=
# Frontend URL allowed to call the API (CORS)
CORS_ORIGIN=

# PostgreSQL connection
DATABASE_URL=

# Frontend URL (where to send users after login)
FRONTEND_URL=

# Google OAuth: from Google Cloud Console > Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Login session: generate with `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=
